<Page x:Class="SmartICAVI.ManualFeeding2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ut="clr-namespace:SmartICAVI.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="600"
      Background="Cornsilk"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
	Title="ManualFeeding2Page">

    <Page.Resources>
        <Style TargetType="{x:Type Label}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Name="title" Grid.Row="0" Content="피 딩" Background="Olive" FontSize="22" FontFamily="Arial" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Border Name="borderFeeding" Grid.Row="1" Style="{StaticResource StyleBorder}">
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <CheckBox Name="cbxAutoRun" Visibility="Hidden" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="5, 5, 5, 20" Padding="1" Click="cbxAutoRun_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <!--<Image Source="Images/Back32.png" Margin="2,0" Stretch="None"/>-->
                        <TextBlock Text="버퍼 컨트롤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
                
                <Label Grid.Row="1" Grid.Column="0" Name="lblJog" Content="연속 구동" HorizontalAlignment="Center"/>
                <CheckBox Grid.Row="1" Grid.Column="1" Name="cbxJogN" Margin="5, 15" Padding="1" Click="cbxJogN_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/Back32.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="- 이동" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
                <CheckBox Grid.Row="1" Grid.Column="2" Name="cbxJogP" Margin="5, 15" Padding="1" Click="cbxJogP_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/Forward32.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="- 이동" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <Label Grid.Row="2" Grid.Column="0" Name="lblRMove" Content="상대위치 이동" HorizontalAlignment="Center"/>
                <UniformGrid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Columns="3">
                    <CheckBox Name="cbxRMoveN" Margin="5, 15" Padding="1" Click="cbxRMoveN_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Image Source="Images/Back32.png" Margin="10,0" Stretch="None"/>
                            <TextBlock Text="- 이동" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                    <TextBox Name="tbxRMove" Text="0.000" Margin="5, 30" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                    <CheckBox Name="cbxRMoveP" Margin="5, 15" Padding="1" Click="cbxRMoveP_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Image Source="Images/Forward32.png" Margin="10,0" Stretch="None"/>
                            <TextBlock Text="+ 이동" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                </UniformGrid>

                <Label Grid.Row="3" Grid.Column="0" Name="lblAMove" Content="절대위치 이동" HorizontalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="tbxAMove" Text="0.000" Margin="5, 30" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <CheckBox Grid.Row="3" Grid.Column="2" Name="cbxAMove" Margin="5, 15" Padding="1" Click="cbxAMove_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/Move32.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="이동" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox Name="btnStop" Visibility="Hidden" Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Click="btnStop_Click" Margin="5, 20, 5, 5" Padding="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_StopStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Margin="10"  Source="Images/Stop48.png" Stretch="None"/>
                        <TextBlock Text="피딩 정지" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
            </Grid>
            
        </Border>
        
        
    </Grid>
</Page>
