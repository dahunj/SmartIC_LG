<Window x:Class="SmartICAVI.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Closed="Window_Closed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="{StaticResource BaseBackground}"
        Title="ReviewWindow" Height="1080" Width="1920">
    
    <Window.Resources>
        <Style x:Key="styleLabel" TargetType="{x:Type Label}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <ItemsPanelTemplate x:Key="panelTemplate">
            <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
            <!--<UniformGrid x:Name="uniGrid" Columns="2" IsItemsHost="True"/>-->
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="0.6*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0"  Grid.ColumnSpan="2" Background="{StaticResource BaseBackground}">
            <Label Name="lblActive" DockPanel.Dock="Left" Margin="3,5,2,5" Padding="2" PreviewMouseLeftButtonDown="lblActive_PreviewMouseLeftButtonDown" Style="{StaticResource styleLabel}">
                <StackPanel Orientation="Horizontal">
                    <Label Name="ledActiveState" Template="{StaticResource TemplateGreenLED}"/>
                    <Label Name="lblActiveState" Content="Verify Disabled" FontSize="18" Foreground="White"/>
                </StackPanel>
            </Label>

            <Label Name="lbLine" DockPanel.Dock="Left" Content="" Margin="3,5,2,5"  Style="{StaticResource styleLabel}"/>

            <Label Name="lblVerifyMethodBorder" DockPanel.Dock="Right" Margin="3,5,2,5" Padding="2" Style="{StaticResource styleLabel}">
                <StackPanel Orientation="Horizontal">
                    <Label Name="lblVerifyMethod" Content="판정방법" FontSize="18" Foreground="White"/>
                    <ComboBox Name="cbVerifyMethod" SelectionChanged="cbVerifyMethod_SelectionChanged" Width="100" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Label>
            
            <Label Name="lblImageArrayBorder" DockPanel.Dock="Right" Margin="3,5,2,5" Padding="2" Style="{StaticResource styleLabel}">
                <StackPanel Orientation="Horizontal">
                    <Label Name="lblImageArray" Content="이미지 배열" FontSize="18" Foreground="White"/>
                    <ComboBox Name="cbImageArray" SelectionChanged="cbImageArray_SelectionChanged" Width="100" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Label>
            
            <Label Name="lblImageNumberBorder" DockPanel.Dock="Right" Margin="3,5,2,5" Padding="2" Style="{StaticResource styleLabel}">
                <StackPanel Orientation="Horizontal">
                    <Label Name="lblImageNumber" Content="이미지 개수" FontSize="18" Foreground="White"/>
                    <ComboBox Name="cbImageNumber" SelectionChanged="cbImageNumber_SelectionChanged" Width="100" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Label>
            <Label Name="lblImageSizeBorder" DockPanel.Dock="Right" Margin="3,5,2,5" Padding="2" Style="{StaticResource styleLabel}">
                <StackPanel Orientation="Horizontal">
                    <Label Name="lblImageSize" Content="이미지 크기" FontSize="18" Foreground="White"/>
                    <ComboBox Name="cbImageSize" SelectionChanged="cbImageSize_SelectionChanged" Width="100" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Label>

            <Label Name="lbTitle" DockPanel.Dock="Left" Content="Review Window" Margin="3,5,2,5"  Style="{StaticResource styleLabel}"/>
        </DockPanel>

        <Border Name="borderTop" Grid.Row="1" Background="Cornsilk" Margin="5,2" Padding="2" Style="{StaticResource StyleBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Background="Olive" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <TextBlock Name="tblTop" Text="TOP" TextWrapping="Wrap" Padding="16" FontSize="18" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" />

                <ListBox Name="lbxTop" Grid.Column="1" Padding="2" BorderBrush="Transparent" Background="Transparent" GotFocus="lbxTop_GotFocus" ItemsPanel="{StaticResource panelTemplate}">
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Margin" Value="10,0"/>
                            <EventSetter Event="MouseDoubleClick" Handler="lbxTop_MouseDoubleClick"/>
                        </Style>
                        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                            <Setter Property="MinWidth" Value="20" />
                            <Setter Property="MinHeight" Value="20" />
                        </Style>
                    </ListBox.Resources>
                </ListBox>
            </Grid>
        </Border>

        <Border Name="borderBottom" Grid.Row="2" Background="Cornsilk" Margin="5,2" Padding="2" Style="{StaticResource StyleBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Background="Olive" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <TextBlock Name="tblBottom" Text="BOTTOM" TextWrapping="Wrap" Padding="16" FontSize="18" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" />

                <ListBox Name="lbxBottom" Grid.Column="1" Padding="2" BorderBrush="Transparent" Background="Transparent" GotFocus="lbxBottom_GotFocus" ItemsPanel="{StaticResource panelTemplate}">
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Margin" Value="10,0"/>
                            <EventSetter Event="MouseDoubleClick" Handler="lbxBottom_MouseDoubleClick"/>
                        </Style>
                        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                            <Setter Property="MinWidth" Value="20" />
                            <Setter Property="MinHeight" Value="20" />
                        </Style>
                    </ListBox.Resources>
                </ListBox>
            </Grid>
        </Border>

        <Border Name="borderMono" Grid.Row="3" Background="Cornsilk" Margin="5,2" Padding="2" Style="{StaticResource StyleBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Background="Olive" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <TextBlock Name="tblMono" Text="MONO" TextWrapping="Wrap" Padding="16" FontSize="18" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" />

                <ListBox Name="lbxMono" Grid.Column="1" Padding="2" BorderBrush="Transparent" Background="Transparent" GotFocus="lbxMono_GotFocus" ItemsPanel="{StaticResource panelTemplate}">
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Margin" Value="10,0"/>
                            <EventSetter Event="MouseDoubleClick" Handler="lbxMono_MouseDoubleClick"/>
                        </Style>
                        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                            <Setter Property="MinWidth" Value="20" />
                            <Setter Property="MinHeight" Value="20" />
                        </Style>
                    </ListBox.Resources>
                </ListBox>
            </Grid>
        </Border>

