<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <LinearGradientBrush x:Key="BtnNormalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="PowderBlue" Offset="0.0"/>
                <GradientStop Color="SteelBlue" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BtnMouseOverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <!--<GradientStop Color="AliceBlue" Offset="0.0"/>-->
                <!--<GradientStop Color="LightBlue" Offset="1.0"/>-->
                <GradientStop Color="Orange" Offset="0.0"/>
                <GradientStop Color="OrangeRed" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BtnPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <!--<GradientStop Color="Black" Offset="0.0"/>
                <GradientStop Color="DarkGray" Offset="1.0"/>-->
                <GradientStop Color="OrangeRed" Offset="0.0"/>
                <GradientStop Color="Orange" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LinearGrayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="WhiteSmoke" Offset="0.0"/>
                <GradientStop Color="DimGray" Offset="1"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>
    
    
    <!--TemplateButton_MenuStyle-->
    <ControlTemplate x:Key="TemplateButton_MenuStyle" TargetType="{x:Type Button}">
        <Border x:Name="border" BorderThickness="1" BorderBrush="RoyalBlue" Background="{StaticResource RoyalBlueBrush}" Margin="5"
                TextBlock.Foreground="White" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="17">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--TemplateButton_SEMStyle-->
    <ControlTemplate x:Key="TemplateButton_SEMStyle" TargetType="{x:Type Button}">
        <Border x:Name="border" BorderThickness="1" BorderBrush="Goldenrod" Background="Goldenrod" Margin="5"
                TextBlock.Foreground="White" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="17">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="Yellow"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGoldenrod" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="Gray" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--TemplateButton_BackgroundStyle-->
    <ControlTemplate x:Key="TemplateButton_BackgroundStyle" TargetType="{x:Type Button}">
        <Border x:Name="border" CornerRadius="7" BorderBrush="#01FFFFFF" Background="#01FFFFFF">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="true">
                <!--<Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />-->
                <Setter TargetName="border" Property="Background" Value="{StaticResource CheckedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--TemplateButton_BorderStyle-->
    <ControlTemplate x:Key="TemplateButton_BorderStyle" TargetType="{x:Type Button}">
        <Border x:Name="border" CornerRadius="7" BorderBrush="SkyBlue" Background="#01FFFFFF" BorderThickness="1">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="true">
                <!--<Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />-->
                <Setter TargetName="border" Property="Background" Value="{StaticResource CheckedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--TemplateButton_LeftRoundStyle-->
    <ControlTemplate x:Key="TemplateButton_LeftRoundStyle" TargetType="{x:Type Button}">
        <Border x:Name="border" CornerRadius="0,0,0,10" BorderThickness="1" BorderBrush="#70FFFFFF" Background="#01FFFFFF" >
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />
                <Setter TargetName="border" Property="BorderBrush" Value="#70FFFFFF" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="#A0FFFFFF"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--TemplateButton_RightRoundStyle-->
    <ControlTemplate x:Key="TemplateButton_RightRoundStyle" TargetType="{x:Type Button}">
        <Border x:Name="border" CornerRadius="0,0,10,0" BorderThickness="1" BorderBrush="#70FFFFFF" Background="#01FFFFFF" >
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />
                <Setter TargetName="border" Property="BorderBrush" Value="#70FFFFFF" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="#A0FFFFFF"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--TemplateButton_RectStyle-->
    <ControlTemplate x:Key="TemplateButton_RectStyle" TargetType="{x:Type Button}">
        <Border x:Name="border" BorderThickness="1" BorderBrush="#70FFFFFF" Background="#01FFFFFF" >
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />
                <Setter TargetName="border" Property="BorderBrush" Value="#70FFFFFF" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="#A0FFFFFF"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--TemplateButton_FlatStyle-->
    <ControlTemplate x:Key="TemplateButton_FlatStyle" TargetType="{x:Type Button}">
        <Border x:Name="border" BorderThickness="1" BorderBrush="White" Background="{StaticResource BaseBackground}"
                TextBlock.Foreground="White" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="17">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--Template Custom Button-->
    <ControlTemplate x:Key="TemplateCustomButton" TargetType="{x:Type Button}">
        <Border x:Name="Border" CornerRadius="7" BorderThickness="1" BorderBrush="Blue" Background="{StaticResource BtnNormalBrush}" TextBlock.Foreground="Black" TextBlock.FontWeight="Bold" >
            <ContentPresenter Margin="{TemplateBinding Button.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsDefaulted" Value="true">
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BtnNormalBrush}"/>
                <!--<Setter TargetName="Border" Property="BorderBrush" Value="Dark" />-->
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Border" Property="Background" Value="{StaticResource BtnMouseOverBrush}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="SkyBlue" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="Border" Property="Background" Value="{StaticResource BtnPressedBrush}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BtnPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="Border" Property="Background" Value="{StaticResource LinearGrayBrush}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource LinearGrayBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>

    </ControlTemplate>



</ResourceDictionary>