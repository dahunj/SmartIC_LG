<Window x:Class="SmartICAVI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartIC AVI" 
        Height="1024" Width="1280"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        WindowState="Maximized"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        >
    <Window.Resources>
        <Style x:Key="styleLabel" TargetType="{x:Type Label}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!--Main Menu-->
        <DockPanel DockPanel.Dock="Bottom" Height="80" Background="{StaticResource BaseBackground}">
            <CheckBox Name="btnAuto" Tag="Auto" DockPanel.Dock="Left" Padding="5" Click="btnAuto_Click" MinWidth="120" MinHeight="80" Template="{StaticResource TemplateCheckBox_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/Auto32.png" Stretch="None"/>
                    <TextBlock Text="자동운전" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <CheckBox Name="btnRecipe" Tag="Recipe" DockPanel.Dock="Left" Padding="5" Click="btnRecipe_Click" MinWidth="120" MinHeight="80" Template="{StaticResource TemplateCheckBox_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/Recipe32.png" Stretch="None"/>
                    <TextBlock Text="레시피" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <CheckBox Name="btnTeach" Tag="btnTeacvh" DockPanel.Dock="Left" Padding="5" Click="btnTeach_Click" MinWidth="120" MinHeight="80" Template="{StaticResource TemplateCheckBox_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/Teach32.png" Stretch="None"/>
                    <TextBlock Text="티칭" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <Button Name="btnReport" Tag="Report" DockPanel.Dock="Left" Padding="5" Click="btnReport_Click" MinWidth="120" MinHeight="80" Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/Report32.png" Stretch="None"/>
                    <TextBlock Text="결과창" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="btnMonitor" Tag="Monitor" DockPanel.Dock="Left" Padding="5" Click="btnMonitor_Click" MinWidth="120" MinHeight="80" Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/Monitor32.png" Stretch="None"/>
                    <TextBlock Text="모니터" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <CheckBox Name="btnSetup" Tag="Setup" DockPanel.Dock="Left" Padding="5" Click="btnSetup_Click" MinWidth="120" MinHeight="80" Template="{StaticResource TemplateCheckBox_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/Setup32.png" Stretch="None"/>
                    <TextBlock Text="셋업" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <CheckBox Name="btnSystemLock" Tag="SystemLock" DockPanel.Dock="Left" Padding="5" Click="btnSystemLock_Click" MinWidth="120" MinHeight="80" Template="{StaticResource TemplateCheckBox_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/lock32.png" Stretch="None"/>
                    <TextBlock Text="시스템잠금" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <CheckBox Name="btnInit" Tag="Init" DockPanel.Dock="Left" Padding="5" Click="btnInit_Click" MinWidth="120" MinHeight="80" Template="{StaticResource TemplateCheckBox_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/Home32.png" Stretch="None"/>
                    <TextBlock Text="원점수행" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <CheckBox Name="btnManual" Tag="Manual" DockPanel.Dock="Left" Padding="5" Click="btnManual_Click" MinWidth="120" MinHeight="80" Template="{StaticResource TemplateCheckBox_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/Manual32.png" Stretch="None"/>
                    <TextBlock Text="수동운전" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <Button Name="btnShutDown" Tag="ShutDown" DockPanel.Dock="Right" Padding="5" Click="btnShutDown_Click" MinWidth="120" MinHeight="80" 
                      Background="Firebrick" BorderBrush="Firebrick"
                      Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel>
                    <Image Source="Images/ShutDown32.png" Stretch="None"/>
                    <TextBlock Text="종료" Foreground="White" FontFamily="Segoe UI" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel DockPanel.Dock="Right" Margin="5" Orientation="Vertical" Visibility="Collapsed">
                <StackPanel Margin="2" Orientation="Horizontal">
                </StackPanel>
                <StackPanel Margin="2" Orientation="Horizontal">
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Left" Background="White" VerticalAlignment="Stretch" Margin="5" Padding="10,5" >
                <Image Name="imageSynapse" Stretch="Uniform"/>
            </Border>
            <TextBlock Name="tblMachineName" DockPanel.Dock="Left" Text="SmartIC AVI" Margin="10,0" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="38" FontWeight="Bold"/>

            <Border DockPanel.Dock="Left" Background="White" VerticalAlignment="Stretch" Margin="5" Padding="5"  >
                <Image Name="imageUser" Stretch="Uniform" />
            </Border>
        </DockPanel>

        <!--Status Bar-->
        <DockPanel DockPanel.Dock="Top" Background="{StaticResource BaseBackground}">

            <!--<Label Name="lbRecipeName" DockPanel.Dock="Left" Content="레시피 : SYN2033" Margin="3,5,2,5"  Style="{StaticResource styleLabel}"/>-->
            <Label DockPanel.Dock="Left" Margin="3,5,2,5"  Style="{StaticResource styleLabel}">
                <TextBlock Name="tblRecipeName" DockPanel.Dock="Left" Text="레시피 : " FontSize="18" FontFamily="Segoe UI" Foreground="White" VerticalAlignment="Center"/>
            </Label>
            <Label Name="lbVelocity" DockPanel.Dock="Left" Content="이송속도 : 0.0" Margin="3,5,2,5"  Style="{StaticResource styleLabel}"/>
            <Label Name="lbPunchCount" DockPanel.Dock="Left" Content="펀칭누적수 : 0/50000" Margin="3,5,2,5"  Style="{StaticResource styleLabel}"/>
            <Label Name="lbRunTime" DockPanel.Dock="Left" Content="작업시간 : 00:00:00" Margin="3,5,2,5"  Style="{StaticResource styleLabel}"/>
            <Label Name="lbCurrentTime" DockPanel.Dock="Left" Content="현재시간 : 2014-08-18:56:42" Margin="3,5,2,5"  Style="{StaticResource styleLabel}"/>
            <Label Name="lbOnline" DockPanel.Dock="Left" Margin="3,5,2,5" Padding="2"  Style="{StaticResource styleLabel}" PreviewMouseDoubleClick="lbOnline_PreviewMouseDoubleClick">
                <StackPanel Orientation="Horizontal">
                    <Label Name="ledOnlineState" Template="{StaticResource TemplateGreenLED}"/>
                    <Label Name="lbOnlineState" Content="Online 설정" FontSize="18" Foreground="White"/>
                </StackPanel>
            </Label>
            <Label Name="lbConnect" DockPanel.Dock="Left" Margin="3,5,2,5" Padding="2"  Style="{StaticResource styleLabel}">
                <StackPanel Orientation="Horizontal" >
                    <Label Name="ledMESConnect" Template="{StaticResource TemplateGreenLED}"/>
                    <Label Name="lbMesConnect" Content="MES 연결" FontSize="18" Foreground="White"/>
                </StackPanel>
            </Label>
            <Label Name="lbCurrentStatus" DockPanel.Dock="Left" Content="현재상태 : 파워 온" Margin="3,5,5,5" HorizontalContentAlignment="Left" Style="{StaticResource styleLabel}"/>
        </DockPanel>

        <!--Main Frame-->
        <Frame Name="mainFrame" DockPanel.Dock="Bottom" JournalOwnership="UsesParentJournal" Source="EmptyPage.xaml"/>
    </DockPanel>
</Window>
