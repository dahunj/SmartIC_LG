<Window x:Class="SmartICAVI.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize"
        Style="{StaticResource StyleCustomWindow}"
        Name="inputWindow"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Closed="inputWindow_Closed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="InputWindow" xmlns:my="clr-namespace:SmartICAVI.UserControls">
    
    <Grid Height="350" Width="500" >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>
                <TextBlock Name="tblMessage" Grid.Row="0" Padding="5" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="20" />
                <TextBlock Name="tblDescription" Grid.Row="1" Padding="5" FontSize="24" TextWrapping="Wrap" Margin="20,0,20,20" />
            </Grid>
        </Grid>
        
        <UniformGrid Grid.Row="1" Columns="2">
            <TextBox Name="tbInput" Margin="10"  />
            <Button Name="btnOK" Margin="5,5,10,5" Click="btnOK_Click" Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Margin="10,0" Source="Images/Apply32.png" Stretch="None"/>
                    <TextBlock Text="확   인" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</Window>
