<Page x:Class="SmartICAVI.SetupMotionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ut="clr-namespace:SmartICAVI.UserControls"
      x:Name="page"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="Cornsilk"
      Loaded="page_Loaded"
      Unloaded="page_Unloaded"
	Title="SetupMotionPage">
    
    <!--<Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.1" To="1" Duration="0:0:0.7" AccelerationRatio="0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>-->

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Padding="10" Style="{StaticResource StyleBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Name="lbTitleMotion" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="9" Content="모션 셋업" FontSize="32" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"/>

                <Border Grid.Row="1" Grid.RowSpan="9" Grid.Column="1" Grid.ColumnSpan="2" Background="SkyBlue" />
                <Label Name="lbTitleVelSlow" Grid.Row="1" Grid.Column="1" Content="원점속도(mm/sec)" FontSize="18" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"/>
                <Label Name="lbTitleAccelSlow" Grid.Row="1" Grid.Column="2" Content="가속도(mm/sec^2)" FontSize="18" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"/>

                <Border Grid.Row="1" Grid.RowSpan="9" Grid.Column="3" Grid.ColumnSpan="2" Background="Bisque" />
                <Label Name="lbTitleVelNormal" Grid.Row="1" Grid.Column="3" Content="조그속도(mm/sec)" FontSize="18" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"/>
                <Label Name="lbTitleAccelNormal" Grid.Row="1" Grid.Column="4" Content="가속도(mm/sec^2)" FontSize="18" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"/>

                <Border Grid.Row="1" Grid.RowSpan="9" Grid.Column="5" Grid.ColumnSpan="2" Background="SkyBlue" />
                <Label Name="lbTitleVelMove" Grid.Row="1" Grid.Column="5" Content="구동속도(mm/sec)" FontSize="18" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"/>
                <Label Name="lbTitleAccelMove" Grid.Row="1" Grid.Column="6" Content="가속도(mm/sec^2)" FontSize="18" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"/>

                <Border Grid.Row="1" Grid.RowSpan="9" Grid.Column="7" Grid.ColumnSpan="2" Background="Bisque" />
                <Label Name="lbTitleVelRapid" Grid.Row="1" Grid.Column="7" Content="최고속도(mm/sec)" FontSize="18" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"/>
                <Label Name="lbTitleAccelRapid" Grid.Row="1" Grid.Column="8" Content="가속도(mm/sec^2)" FontSize="18" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"/>

                <ut:GroupCheckBox x:Name="cbVisionFeed" Grid.Row="2" Grid.Column="0"  Margin="5" Template="{StaticResource TemplateCheckBox_GroupStyle}">
                    <Label Name="lbVisionFeed" Content="Vision Feed" Padding="20,0" FontSize="18" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                </ut:GroupCheckBox>
                <ut:SelectTextBox x:Name="tbVisionFeed_VelSlow" Text="1.0" Grid.Row="2" Grid.Column="1" Margin="10" Tag="Vision Feed Velocity (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionFeed_AccelSlow" Text="1.0" Grid.Row="2" Grid.Column="2" Margin="10" Tag="Vision Feed Accel (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionFeed_VelNormal" Text="1.0" Grid.Row="2" Grid.Column="3" Margin="10" Tag="Vision Feed Velocity (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionFeed_AccelNormal" Text="1.0" Grid.Row="2" Grid.Column="4" Margin="10" Tag="Vision Feed Accel (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionFeed_VelMove" Text="1.0" Grid.Row="2" Grid.Column="5" Margin="10" Tag="Vision Feed Velocity (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionFeed_AccelMove" Text="1.0" Grid.Row="2" Grid.Column="6" Margin="10" Tag="Vision Feed Accel (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionFeed_VelRapid" Text="1.0" Grid.Row="2" Grid.Column="7" Margin="10" Tag="Vision Feed Velocity (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionFeed_AccelRapid" Text="1.0" Grid.Row="2" Grid.Column="8" Margin="10" Tag="Vision Feed Accel (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>


                <ut:GroupCheckBox x:Name="cbVisionTop" Grid.Row="3" Grid.Column="0"  Margin="5" Template="{StaticResource TemplateCheckBox_GroupStyle}">
                    <Label Name="lbVisionTop" Content="Vision Top" Padding="20,0" FontSize="18" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                </ut:GroupCheckBox>
                <ut:SelectTextBox x:Name="tbVisionTop_VelSlow" Text="1.0" Grid.Row="3" Grid.Column="1" Margin="10" Tag="Vision Top Velocity (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionTop_AccelSlow" Text="1.0" Grid.Row="3" Grid.Column="2" Margin="10" Tag="Vision Top Accel (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionTop_VelNormal" Text="1.0" Grid.Row="3" Grid.Column="3" Margin="10" Tag="Vision Top Velocity (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionTop_AccelNormal" Text="1.0" Grid.Row="3" Grid.Column="4" Margin="10" Tag="Vision Top Accel (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionTop_VelMove" Text="1.0" Grid.Row="3" Grid.Column="5" Margin="10" Tag="Vision Top Velocity (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionTop_AccelMove" Text="1.0" Grid.Row="3" Grid.Column="6" Margin="10" Tag="Vision Top Accel (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionTop_VelRapid" Text="1.0" Grid.Row="3" Grid.Column="7" Margin="10" Tag="Vision Top Velocity (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionTop_AccelRapid" Text="1.0" Grid.Row="3" Grid.Column="8" Margin="10" Tag="Vision Top Accel (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>

                <ut:GroupCheckBox x:Name="cbVisionBottom" Grid.Row="4" Grid.Column="0"  Margin="5" Template="{StaticResource TemplateCheckBox_GroupStyle}">
                    <Label Name="lbVisionBottom" Content="Vision Bottom" Padding="20,0" FontSize="18" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                </ut:GroupCheckBox>
                <ut:SelectTextBox x:Name="tbVisionBottom_VelSlow" Text="1.0" Grid.Row="4" Grid.Column="1" Margin="10" Tag="Vision Bottom Velocity (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionBottom_AccelSlow" Text="1.0" Grid.Row="4" Grid.Column="2" Margin="10" Tag="Vision Bottom Accel (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionBottom_VelNormal" Text="1.0" Grid.Row="4" Grid.Column="3" Margin="10" Tag="Vision Bottom Velocity (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionBottom_AccelNormal" Text="1.0" Grid.Row="4" Grid.Column="4" Margin="10" Tag="Vision Bottom Accel (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionBottom_VelMove" Text="1.0" Grid.Row="4" Grid.Column="5" Margin="10" Tag="Vision Bottom Velocity (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionBottom_AccelMove" Text="1.0" Grid.Row="4" Grid.Column="6" Margin="10" Tag="Vision Bottom Accel (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionBottom_VelRapid" Text="1.0" Grid.Row="4" Grid.Column="7" Margin="10" Tag="Vision Bottom Velocity (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbVisionBottom_AccelRapid" Text="1.0" Grid.Row="4" Grid.Column="8" Margin="10" Tag="Vision Bottom Accel (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>


                <ut:GroupCheckBox x:Name="cbPunchFeed" Grid.Row="6" Grid.Column="0"  Margin="5" Template="{StaticResource TemplateCheckBox_GroupStyle}">
                    <Label Name="lbPunchFeed" Content="Punch Feed" Padding="20,0" FontSize="18" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                </ut:GroupCheckBox>
                <ut:SelectTextBox x:Name="tbPunchFeed_VelSlow" Text="1.0" Grid.Row="6" Grid.Column="1" Margin="10" Tag="Punch Feed Velocity (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchFeed_AccelSlow" Text="1.0" Grid.Row="6" Grid.Column="2" Margin="10" Tag="Punch Feed Accel (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchFeed_VelNormal" Text="1.0" Grid.Row="6" Grid.Column="3" Margin="10" Tag="Punch Feed Velocity (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchFeed_AccelNormal" Text="1.0" Grid.Row="6" Grid.Column="4" Margin="10" Tag="Punch Feed Accel (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchFeed_VelMove" Text="1.0" Grid.Row="6" Grid.Column="5" Margin="10" Tag="Punch Feed Velocity (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchFeed_AccelMove" Text="1.0" Grid.Row="6" Grid.Column="6" Margin="10" Tag="Punch Feed Accel (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchFeed_VelRapid" Text="1.0" Grid.Row="6" Grid.Column="7" Margin="10" Tag="Punch Feed Velocity (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchFeed_AccelRapid" Text="1.0" Grid.Row="6" Grid.Column="8" Margin="10" Tag="Punch Feed Accel (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>


                <ut:GroupCheckBox x:Name="cbPunchX" Grid.Row="7" Grid.Column="0"  Margin="5" Template="{StaticResource TemplateCheckBox_GroupStyle}">
                    <Label Name="lbPunchX" Content="Punch X" Padding="20,0" FontSize="18" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                </ut:GroupCheckBox>
                <ut:SelectTextBox x:Name="tbPunchX_VelSlow" Text="1.0" Grid.Row="7" Grid.Column="1" Margin="10" Tag="Punch X Velocity (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchX_AccelSlow" Text="1.0" Grid.Row="7" Grid.Column="2" Margin="10" Tag="Punch X Accel (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchX_VelNormal" Text="1.0" Grid.Row="7" Grid.Column="3" Margin="10" Tag="Punch X Velocity (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchX_AccelNormal" Text="1.0" Grid.Row="7" Grid.Column="4" Margin="10" Tag="Punch X Accel (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchX_VelMove" Text="1.0" Grid.Row="7" Grid.Column="5" Margin="10" Tag="Punch X Velocity (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchX_AccelMove" Text="1.0" Grid.Row="7" Grid.Column="6" Margin="10" Tag="Punch X Accel (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchX_VelRapid" Text="1.0" Grid.Row="7" Grid.Column="7" Margin="10" Tag="Punch X Velocity (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchX_AccelRapid" Text="1.0" Grid.Row="7" Grid.Column="8" Margin="10" Tag="Punch X Accel (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>


                <ut:GroupCheckBox x:Name="cbPunchY" Grid.Row="8" Grid.Column="0"  Margin="5" Template="{StaticResource TemplateCheckBox_GroupStyle}">
                    <Label Name="lbPunchY" Content="Punch Y" Padding="20,0" FontSize="18" HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                </ut:GroupCheckBox>
                <ut:SelectTextBox x:Name="tbPunchY_VelSlow" Text="1.0" Grid.Row="8" Grid.Column="1" Margin="10" Tag="Punch Y Velocity (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchY_AccelSlow" Text="1.0" Grid.Row="8" Grid.Column="2" Margin="10" Tag="Punch Y Accel (Origin)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchY_VelNormal" Text="1.0" Grid.Row="8" Grid.Column="3" Margin="10" Tag="Punch Y Velocity (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchY_AccelNormal" Text="1.0" Grid.Row="8" Grid.Column="4" Margin="10" Tag="Punch Y Accel (Jog)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchY_VelMove" Text="1.0" Grid.Row="8" Grid.Column="5" Margin="10" Tag="Punch Y Velocity (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchY_AccelMove" Text="1.0" Grid.Row="8" Grid.Column="6" Margin="10" Tag="Punch Y Accel (Move)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchY_VelRapid" Text="1.0" Grid.Row="8" Grid.Column="7" Margin="10" Tag="Punch Y Velocity (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                <ut:SelectTextBox x:Name="tbPunchY_AccelRapid" Text="1.0" Grid.Row="8" Grid.Column="8" Margin="10" Tag="Punch Y Accel (Rapid)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbx_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>

            </Grid>
        </Border>
        <DockPanel Grid.Row="1" LastChildFill="False">
            <Button Name="btnCancel" Tag="Cancel" DockPanel.Dock="Right" Click="btnCancel_Click" Margin="5" Padding="5" Width="150" VerticalAlignment="Center" HorizontalAlignment="Center" Template="{StaticResource TemplateCustomButton}">
                <StackPanel>
                    <Image Source="Images/Cancel32.png" Stretch="None"/>
                    <TextBlock Text="취소" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Name="btnSave" Tag="Save" DockPanel.Dock="Right" Click="btnSave_Click" Margin="5" Padding="5" Width="150" VerticalAlignment="Center" HorizontalAlignment="Center" Template="{StaticResource TemplateCustomButton}">
                <StackPanel>
                    <Image Source="Images/Save32.png" Stretch="None"/>
                    <TextBlock Text="저장" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>

</Page>
