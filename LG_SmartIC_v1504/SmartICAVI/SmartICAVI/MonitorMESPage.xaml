<Page x:Class="SmartICAVI.MonitorMESPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="600"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
	Title="MonitorMESPage">

    <Border Background="Gainsboro" CornerRadius="5" BorderBrush="DarkBlue" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="Transparent" Margin="5" CornerRadius="5" BorderBrush="DarkBlue" BorderThickness="1">
                <DockPanel>
                    <Label Name="lblTitleSend" DockPanel.Dock="Top" Content="Send" Foreground="Black" FontSize="17" Style="{StaticResource StyleLabel}"/>
                    <ListBox Name="lbSend" DockPanel.Dock="Bottom" Margin="5" Padding="10" Background="Transparent">
                        <ListBox.Resources>
                            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                                <Setter Property="MinWidth" Value="40" />
                                <Setter Property="MinHeight" Value="40" />
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>
            </Border>

            <!--Splitter-->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Opacity="0"/>

            <Border Grid.Column="2" Background="Transparent" Margin="5" CornerRadius="5" BorderBrush="DarkBlue" BorderThickness="1">
                <DockPanel>
                    <Label Name="lblTitleReceive" DockPanel.Dock="Top" Content="Receive" Foreground="Black" FontSize="17" Style="{StaticResource StyleLabel}"/>
                    <ListBox Name="lbxReceive" DockPanel.Dock="Bottom" Margin="5" Padding="10" Background="Transparent">
                        <ListBox.Resources>
                            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                                <Setter Property="MinWidth" Value="40" />
                                <Setter Property="MinHeight" Value="40" />
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>
            </Border>

        </Grid>
    </Border>

</Page>
