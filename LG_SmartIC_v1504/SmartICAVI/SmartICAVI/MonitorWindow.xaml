<Window x:Class="SmartICAVI.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorWindow" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource StyleOperateWindow}"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Closed="Window_Closed"
        >
    <DockPanel>
        <DockPanel DockPanel.Dock="Right" LastChildFill="False">
            <CheckBox Name="btnMotion" Tag="Motion" DockPanel.Dock="Top" Click="btnCheckBox_Click" Margin="5" Width="90" Height="70" Template="{StaticResource TemplateCheckBox_BackgroundStyle}">
                <StackPanel>
                    <Image Margin="5" Source="Images/MotionGreen32.png" Stretch="None"/>
                    <TextBlock Name="tbxMotion" Text="모션" Foreground="Black" FontFamily="Segoe UI" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <CheckBox Name="btnDio" Tag="Dio" DockPanel.Dock="Top" Click="btnCheckBox_Click" Margin="5" Width="90" Height="70" Template="{StaticResource TemplateCheckBox_BackgroundStyle}">
                <StackPanel>
                    <Image Margin="5" Source="Images/DioGreen32.png" Stretch="None"/>
                    <TextBlock Name="tbxDio" Text="입출력" Foreground="Black" FontFamily="Segoe UI" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <CheckBox Name="btnCommu" Tag="Commu" DockPanel.Dock="Top" Click="btnCheckBox_Click" Visibility="Collapsed" Margin="5" Width="90" Height="70" Template="{StaticResource TemplateCheckBox_BackgroundStyle}">
                <StackPanel>
                    <Image Margin="5" Source="Images/CommuGreen32.png" Stretch="None"/>
                    <TextBlock Name="tbxCommu" Text="MES" Foreground="Black" FontFamily="Segoe UI" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <CheckBox Name="btnLog" Tag="Log" DockPanel.Dock="Top" Click="btnCheckBox_Click" Margin="5" Width="90" Height="70" Template="{StaticResource TemplateCheckBox_BackgroundStyle}">
                <StackPanel>
                    <Image Margin="5" Source="Images/LogGreen32.png" Stretch="None"/>
                    <TextBlock Name="tbxLog" Text="로그" Foreground="Black" FontFamily="Segoe UI" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>
            <CheckBox Name="btnSystem" Tag="System" DockPanel.Dock="Top" Click="btnCheckBox_Click" Margin="5" Width="90" Height="70" Template="{StaticResource TemplateCheckBox_BackgroundStyle}">
                <StackPanel>
                    <Image Margin="5" Source="Images/SystemGreen32.png" Stretch="None"/>
                    <TextBlock Name="tbxSystem" Text="시스템" Foreground="Black" FontFamily="Segoe UI" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </CheckBox>

            <Button Name="btnCancel" Tag="Cancel" DockPanel.Dock="Bottom" Click="btnCancel_Click" Margin="5" Width="90" Height="70" VerticalAlignment="Center" HorizontalAlignment="Center" Template="{StaticResource TemplateButton_BackgroundStyle}">
                <StackPanel>
                    <Image Margin="5" Source="Images/CancelGreen32.png" Stretch="None"/>
                    <TextBlock Name="tbxCancel" Text="종료" Foreground="Black" FontFamily="Segoe UI" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </DockPanel>

        <Frame Name="monitorFrame" DockPanel.Dock="Left" Margin="5" JournalOwnership="UsesParentJournal"/>
    </DockPanel>
</Window>
