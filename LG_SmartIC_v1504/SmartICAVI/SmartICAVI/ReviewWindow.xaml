                <TextBlock Name="tblPunch" Text="PUNCH" TextWrapping="Wrap" Padding="8" FontSize="18" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" />

                <ListBox Name="lbxPunch" Grid.Row="1" Padding="2" BorderBrush="Transparent" Background="Transparent" >
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ListBoxItem}">
