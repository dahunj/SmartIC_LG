<Window x:Class="SmartICAVI.ManualTunningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource StyleCustomWindow}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Closed="Window_Closed"
        Title="ManualTunningWindow" Height="700" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="0.35*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="5" Style="{StaticResource StyleBorder}">
            <UniformGrid Rows="2" Columns="2">
                <Label Name="lbVoffset" Content="Analog Offset (-10~10V) : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbVoffset" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
                <Label Name="lbVjog" Content="Jog (-10~10V) : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbVjog" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
            </UniformGrid>
        </Border>

        <Border Grid.Row="1" Padding="5" Style="{StaticResource StyleBorder}">
            <UniformGrid Rows="5" Columns="2">
                <Label Name="lbKp0" Content="Kp0 : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbKp0" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
                <Label Name="lbKi0" Content="Ki0 : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbKi0" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
                <Label Name="lbKd0" Content="Kd0 : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbKd0" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>

                <Label Name="lbVmin0" Visibility="Collapsed" Content="Vmin0 : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbVmin0" Visibility="Collapsed" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
                <Label Name="lbVmax0" Content="Vmax0 : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbVmax0" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>

                <Label Name="lbInpos0" Content="Inposition0 : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbInpos0" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Padding="5" Style="{StaticResource StyleBorder}">
            <UniformGrid Rows="5" Columns="2">
                <Label Name="lbKp" Content="Kp : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbKp" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
                <Label Name="lbKi" Content="Ki : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbKi" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
                <Label Name="lbKd" Content="Kd : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbKd" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>

                <Label Name="lbVmin" Visibility="Collapsed" Content="Vmin : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbVmin" Visibility="Collapsed" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
                <Label Name="lbVmax" Content="Vmax : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbVmax" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>

                <Label Name="lbInpos" Content="Inposition : " FontSize="14" HorizontalAlignment="Right"/>
                <TextBox Name="tbInpos" FontSize="14" Margin="1" Style="{StaticResource StyleTextBox}"/>
            </UniformGrid>
        </Border>

        <UniformGrid Grid.Row="3" Columns="2">
            <Button Name="btnOK" Margin="5" Click="btnOK_Click" Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Margin="10,0" Source="Images/CancelGreen32.png" Stretch="None"/>
                    <TextBlock Text="종   료" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Name="btnApply" Margin="5" Click="btnApply_Click" Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Margin="10,0" Source="Images/Apply32.png" Stretch="None"/>
                    <TextBlock Text="적   용" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</Window>
