<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <LinearGradientBrush x:Key="NormalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="PowderBlue" Offset="0.0"/>
                <GradientStop Color="SteelBlue" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LinearGrayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="WhiteSmoke" Offset="0.0"/>
                <GradientStop Color="DimGray" Offset="1"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <!--RoyalBlue Brush-->
    <LinearGradientBrush x:Key="RoyalBlueBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="RoyalBlue" Offset="0.0"/>
                <GradientStop Color="RoyalBlue" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <!--Green Brush-->
    <LinearGradientBrush x:Key="GreenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="Green" Offset="0.0"/>
                <GradientStop Color="Green" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <!--Disable Brush-->
    <LinearGradientBrush x:Key="DisableBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="Gray" Offset="0.0"/>
                <GradientStop Color="Gray" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <!--Transparent Brush-->
    <LinearGradientBrush x:Key="TransparentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#01FFFFFF" Offset="0.0"/>
                <GradientStop Color="#01FFFFFF" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>


    <!--Pressed Brush-->
    <LinearGradientBrush x:Key="PressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="DarkBlue" Offset="0.0"/>
                <GradientStop Color="SteelBlue" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <!--Pressed background Brush-->
    <LinearGradientBrush x:Key="PressedBrush_BackgroundType" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#E0000000" Offset="0.0"/>
                <GradientStop Color="#00000000" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <!--Checked Brush-->
    <LinearGradientBrush x:Key="CheckedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="OrangeRed" Offset="0.0"/>
                <GradientStop Color="Orange" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    <!--Checked background Brush-->
    <LinearGradientBrush x:Key="CheckedBrush_BackgroundType" StartPoint="0,0" EndPoint="0,1">
        <GradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#90000000" Offset="0.0"/>
                <GradientStop Color="#00000000" Offset="1.0"/>
            </GradientStopCollection>
        </GradientBrush.GradientStops>
    </LinearGradientBrush>

    
    
    <!--TemplateCheckBox_MenuStyle-->
    <ControlTemplate x:Key="TemplateCheckBox_MenuStyle" TargetType="{x:Type CheckBox}">
        <Border x:Name="border" BorderThickness="1" BorderBrush="RoyalBlue" Background="{StaticResource RoyalBlueBrush}" Margin="5"
                TextBlock.Foreground="White" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="17">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource CheckedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    
    <!--TemplateCheckBox_AnimationMenuStyle-->
    <ControlTemplate x:Key="TemplateCheckBox_AnimationMenuStyle" TargetType="{x:Type CheckBox}">
        <Border x:Name="border" BorderThickness="1" BorderBrush="RoyalBlue" Background="{StaticResource RoyalBlueBrush}" Margin="5"
                TextBlock.Foreground="White" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="17">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource CheckedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                <!-- Animation -->
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                To="DarkBlue"
                                                Duration="0:0:1" AutoReverse="True"  RepeatBehavior="Forever" AccelerationRatio="0.5"/>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                To="SteelBlue"
                                                Duration="0:0:1" AutoReverse="True"  RepeatBehavior="Forever"  AccelerationRatio="0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                Duration="0:0:0.3" AccelerationRatio="1"/>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                Duration="0:0:0.3" AccelerationRatio="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--TemplateCheckBox_StopStyle-->
    <ControlTemplate x:Key="TemplateCheckBox_StopStyle" TargetType="{x:Type CheckBox}">
        <Border x:Name="border" CornerRadius="7" BorderThickness="1" BorderBrush="Red" Background="{StaticResource TransparentBrush}">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource CheckedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                <!-- Animation -->
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                To="DarkRed"
                                                Duration="0:0:1" AutoReverse="True"  RepeatBehavior="Forever" AccelerationRatio="0.5"/>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                To="Red"
                                                Duration="0:0:1" AutoReverse="True"  RepeatBehavior="Forever"  AccelerationRatio="0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                Duration="0:0:0.3" AccelerationRatio="1"/>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                Duration="0:0:0.3" AccelerationRatio="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--TemplateCheckBox_GreenStyle-->
    <ControlTemplate x:Key="TemplateCheckBox_GreenStyle" TargetType="{x:Type CheckBox}">
        <Border x:Name="border" CornerRadius="7" BorderThickness="1" BorderBrush="DarkGreen" Background="{StaticResource TransparentBrush}">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                <!-- Animation -->
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                To="DarkGreen"
                                                Duration="0:0:1" AutoReverse="True"  RepeatBehavior="Forever" AccelerationRatio="0.5"/>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                To="LimeGreen"
                                                Duration="0:0:1" AutoReverse="True"  RepeatBehavior="Forever"  AccelerationRatio="0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                Duration="0:0:0.3" AccelerationRatio="1"/>
                            <ColorAnimation Storyboard.TargetName="border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                Duration="0:0:0.3" AccelerationRatio="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    
    <!--TemplateCheckBox_BackGroundStyle-->
    <ControlTemplate x:Key="TemplateCheckBox_BackgroundStyle" TargetType="{x:Type CheckBox}">
        <Border x:Name="border" CornerRadius="7" BorderBrush="#01FFFFFF" Background="#01FFFFFF">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="true">
                <!--<Setter TargetName="border" Property="Background" Value="{StaticResource CheckedBrush_BackgroundType}" />-->
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--TemplateCheckBox_SelectStyle-->
    <ControlTemplate x:Key="TemplateCheckBox_SelectStyle" TargetType="{x:Type CheckBox}">
        <Border x:Name="border" CornerRadius="5" BorderThickness="1" BorderBrush="SkyBlue" Background="#01FFFFFF">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="false">
                <!--<Setter TargetName="border" Property="BorderBrush" Value="#00FFFFFF" />-->
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="Background" Value="Gray" />
            </Trigger>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource CheckedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />
                <Setter TargetName="border" Property="BorderBrush" Value="#AA202020" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="Blue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>

            
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--TemplateCheckBox_GroupStyle-->
    <ControlTemplate x:Key="TemplateCheckBox_GroupStyle" TargetType="{x:Type CheckBox}">
        <Border x:Name="border" CornerRadius="5" BorderThickness="1" BorderBrush="SkyBlue" Background="#01FFFFFF">
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="BorderBrush" Value="#00FFFFFF" />
                <!--<Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />-->
                <Setter TargetName="border" Property="Background" Value="#00FFFFFF" />
            </Trigger>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource CheckedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="#AAFFFFFF" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush_BackgroundType}" />
                <Setter TargetName="border" Property="BorderBrush" Value="#AA202020" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>


        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--TemplateCheckBox_JogStyle-->
    <ControlTemplate x:Key="TemplateCheckBox_JogStyle" TargetType="{x:Type CheckBox}">
        <Border x:Name="border" CornerRadius="7" BorderThickness="1" BorderBrush="RoyalBlue" Background="{StaticResource GreenBrush}" 
                TextBlock.Foreground="White" TextBlock.FontFamily="Segoe UI" TextBlock.FontSize="17" Opacity="0.8" TextBlock.TextAlignment="Center" >
            <ContentPresenter Margin="{TemplateBinding CheckBox.Padding}" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource CheckedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkBlue" />
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="border" Property="BorderBrush" Value="SkyBlue"/>
                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DisableBrush}" />
                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray" />
                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--CheckBox Template-->
    <ControlTemplate x:Key="CheckBoxTemplate" TargetType="{x:Type CheckBox}">
        <Border x:Name="Border" CornerRadius="7" BorderThickness="1" BorderBrush="White"  Background="{StaticResource NormalBrush}" TextBlock.Foreground="Black" TextBlock.FontWeight="Bold" >
            <ContentPresenter Margin="{TemplateBinding Button.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <!--<Setter TargetName="Border" Property="Background" Value="{StaticResource MouseOverBrush}" />-->
                <!-- Animation -->
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="Border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                To="LightSteelBlue"
                                                Duration="0:0:0.3" AccelerationRatio="0.9"/>
                            <ColorAnimation Storyboard.TargetName="Border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                To="SteelBlue"
                                                Duration="0:0:0.3" AccelerationRatio="0.9"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="Border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                Duration="0:0:0.2" AccelerationRatio="1"/>
                            <ColorAnimation Storyboard.TargetName="Border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                Duration="0:0:0.2" AccelerationRatio="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="Border" Property="BorderBrush" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="Border" Property="Background" Value="{StaticResource PressedBrush}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PressedBrush}" />
                <!-- Animation -->
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="Border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                To="Orange"
                                                Duration="0:0:1" AutoReverse="True"  RepeatBehavior="Forever" AccelerationRatio="0.9"/>
                            <ColorAnimation Storyboard.TargetName="Border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                To="OrangeRed"
                                                Duration="0:0:1" AutoReverse="True"  RepeatBehavior="Forever"  AccelerationRatio="0.9"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetName="Border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                Duration="0:0:0.3" AccelerationRatio="1"/>
                            <ColorAnimation Storyboard.TargetName="Border"
                                                Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                Duration="0:0:0.3" AccelerationRatio="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter TargetName="Border" Property="Background" Value="{StaticResource LinearGrayBrush}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource LinearGrayBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <!--/CheckBox Template-->


    <Style x:Key="StyleCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border Name="windowFrame" BorderThickness="0"  Background="{x:Null}">
                        <!-- The Content. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <AdornerDecorator>
                                <ContentPresenter>

                                </ContentPresenter>
                            </AdornerDecorator>

                            <Border Grid.Column="1">
                                <Border.Background>
                                    <VisualBrush Opacity="1.0" Stretch="None">
                                        <VisualBrush.Visual>
                                            <Path Name="path" Opacity="1.0" Data="M 0 5 L 3 15 15 0" Stroke="DarkGray" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Name="text" Grid.Column="2" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{TemplateBinding Tag}" TextWrapping="Wrap" FontSize="16" FontWeight="Black"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="path" Property="Opacity" Value="1.0" />
                            <Setter TargetName="path" Property="Stroke" Value="Green" />
                            <Setter TargetName="path" Property="StrokeThickness" Value="4" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="DarkGray" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>