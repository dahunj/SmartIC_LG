<Window x:Class="SmartICAVI.JobInitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ut="clr-namespace:SmartICAVI.UserControls"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Closed="Window_Closed"
        Name="jobInitWindow"
        Style="{StaticResource StyleCustomWindow}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Opacity="0.99"
        Title="JobInitWindow" Height="900" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Margin="10" Background="White" Style="{StaticResource StyleBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="tblJog" Grid.Column="0" Text="연속구동" FontSize="26" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <Button x:Name="btnJogVel" Grid.Row="0" Grid.Column="1" Tag="btnJogVel" Margin="10" Padding="1" Click="btnJogVel_Click" Template="{StaticResource TemplateButton_BorderStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <!--<Image Source="Images/Apply48.png" Margin="10,0" Stretch="None"/>-->
                        <TextBlock Name="tblJogVel" Text="속도 : " FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                
                <CheckBox x:Name="btnJogN" Grid.Column="2" Tag="JogN" Margin="10" Padding="5" Click="btnJogN_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/Back48.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="JOG -" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox x:Name="btnJogP" Grid.Column="3" Tag="JogP" Margin="10" Padding="5" Click="btnJogP_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/Forward48.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="JOG +" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Name="tblRMove" Text="위치이동 (mm) : " FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="cbRMove" Margin="10" MinWidth="200" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Stretch" FontSize="40" FontWeight="Bold"/>
                <CheckBox Name="btnRMoveN" Grid.Row="1" Grid.Column="2" Margin="10" Click="btnRMoveN_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/MoveBack48.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="(-) 이동" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox Name="btnRMoveP" Grid.Row="1" Grid.Column="3" Margin="10" Click="btnRMoveP_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/MoveForward48.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="(+) 이동" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox x:Name="btnJogStop" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="10" Click="btnJogStop_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/Stop48.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="구동 정지" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="10" Margin="10" Background="White" Style="{StaticResource StyleBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="tblInitPosSearch" Grid.Column="0" Grid.ColumnSpan="2" Text="초기위치 찾기" FontSize="26" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <CheckBox x:Name="btnInitPosSearch" Grid.Column="2" Grid.ColumnSpan="2" Tag="InitPosSerarch" Margin="10" Padding="5" Click="btnInitPosSearch_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/SetZero48.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="초기위치 찾기" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <TextBlock Name="tblInitOffset" Grid.Row="1" Grid.Column="0" Text="초기위치 옵셋" FontSize="26" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Name="tbxInitOffset" Grid.Row="1" Grid.Column="1" Text="0.0" Tag="Init Pos Offset" Margin="10" FontSize="24" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource StyleTextBox}"/>

                <Button x:Name="btnInitOffset" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Tag="btnInitOffset" Margin="10" Padding="1" Click="btnInitOffset_Click" Template="{StaticResource TemplateButton_BorderStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Source="Images/Apply48.png" Margin="10,0" Stretch="None"/>
                        <TextBlock Text="위치 이동" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>



                <TextBlock Name="tblStartUnit" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="검사시작 유닛 설정" FontSize="26" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Name="tbxStartUnit" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="0" Tag="Start Unit" Margin="10" FontSize="24" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource StyleTextBox}"/>


            </Grid>
        </Border>

        <UniformGrid Grid.Row="4" Columns="2">
            <Button Name="btnCancel" Margin="5,0,5,5" Click="btnCancel_Click" Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Margin="10,0" Source="Images/Cancel32.png" Stretch="None"/>
                    <TextBlock Text="작업 취소" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Name="btnOK" Margin="5,0,5,5" Click="btnOK_Click" Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Margin="10,0" Source="Images/Apply32.png" Stretch="None"/>
                    <TextBlock Name="tblOK" Text="작업 시작" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</Window>
