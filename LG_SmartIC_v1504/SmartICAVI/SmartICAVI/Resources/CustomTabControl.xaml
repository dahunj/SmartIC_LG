<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="StyleTabControl" TargetType="{x:Type TabControl}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Name="headerPanel" Grid.Row="0" Margin="0,0,4,-1" Orientation="Horizontal" Panel.ZIndex="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="Transparent" />
                        <Border Name="border" Grid.Row="1" Background="Transparent" BorderBrush="#AAFFFFFF" BorderThickness="1" CornerRadius="0,5,5,5"
                                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" >
                            <ContentPresenter Name="PART_SelectedContentHost" Margin="4" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="DarkGray" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#AAAAAA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyleTabItem" TargetType="{x:Type TabItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <ControlTemplate.Resources>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" x:Key="DisableBackground">
                            <GradientStop Offset="0" Color="Gray"/>
                            <GradientStop Offset="0.3" Color="Gray"/>
                            <GradientStop Offset="0.7" Color="DarkGray"/>
                            <GradientStop Offset="1" Color="DarkGray"/>
                        </LinearGradientBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" x:Key="InactiveBackground">
                            <GradientStop Offset="0" Color="Gray"/>
                            <GradientStop Offset="0.3" Color="Gray"/>
                            <GradientStop Offset="0.7" Color="Gray"/>
                            <GradientStop Offset="1" Color="Gray"/>
                        </LinearGradientBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" x:Key="ActiveBackground">
                            <GradientStop Offset="0" Color="#FF00394D"/>
                            <GradientStop Offset="0.3" Color="#FF00394D"/>
                            <GradientStop Offset="0.7" Color="#FF00394D"/>
                            <GradientStop Offset="1" Color="#FF00394D"/>
                        </LinearGradientBrush>
                    </ControlTemplate.Resources>

                    <Grid Margin="0,0,-12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>

                        <Path x:Name="leftStroke" Grid.Column="0" Stretch="Fill" Stroke="#AAFFFFFF" Fill="Transparent"
                              Data="M0,30 L0,7 C0,3 3,0 7,0 " />
                        <Path x:Name="leftBorder" Grid.Column="0" Margin="1,1,0,0" Stretch="Fill" Fill="{StaticResource InactiveBackground}"
                               Data="M0,7 C0,3 3,0 7,0 L7,30 L0,30 Z" />

                        <Path x:Name="mainStroke" Grid.Column="1" Stroke="#AAFFFFFF" Stretch="Fill" Fill="Transparent" 
                              Data="M0,0 L10,0 10,10" />
                        <Border x:Name="mainBorder" Grid.Column="1" Margin="0,1,0,0" Background="{StaticResource InactiveBackground}"/>

                        <Path x:Name="rightStroke" Grid.Column="2" Stroke="#AAFFFFFF" Stretch="Fill" Fill="Transparent" 
                              Data="M6.5,2.6C4.767,0.973 2.509,0 0,0 0,0 0,19 0,19L23,19z" />
                        <Path x:Name="rightBorder" Grid.Column="2" Margin="0,1,1,0" Stretch="Fill" Fill="{StaticResource InactiveBackground}"
                              Data="M6.5,2.6C4.767,0.973 2.509,0 0,0 0,0 0,19 0,19L23,19z" />

                        <ContentPresenter x:Name="content" Grid.Column="1" TextElement.Foreground="White" TextElement.FontSize="17" Margin="10"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="100" />
                            <Setter TargetName="leftBorder" Property="Fill" Value="{StaticResource ActiveBackground}" />
                            <Setter TargetName="mainBorder" Property="Background" Value="{StaticResource ActiveBackground}" />
                            <Setter TargetName="rightBorder" Property="Fill" Value="{StaticResource ActiveBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="leftBorder" Property="Fill" Value="{StaticResource DisableBackground}" />
                            <Setter TargetName="mainBorder" Property="Background" Value="{StaticResource DisableBackground}" />
                            <Setter TargetName="rightBorder" Property="Fill" Value="{StaticResource DisableBackground}" />
                            <Setter Property="Foreground" Value="#888888" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>