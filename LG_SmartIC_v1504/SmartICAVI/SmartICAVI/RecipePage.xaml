<Page x:Class="SmartICAVI.RecipePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ut="clr-namespace:SmartICAVI.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="1024" d:DesignWidth="1280"
      Background="Cornsilk"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
	Title="RecipePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.RowSpan="2" Name="bdRecipe" Style="{StaticResource StyleBorder}">
                <DockPanel>
                    <DockPanel Height="75" DockPanel.Dock="Top">
                        <Button Name="btnSelect" Tag="Select" DockPanel.Dock="Right" Click="btnSelect_Click" Margin="5" Padding="5" Width="110" VerticalAlignment="Center" HorizontalAlignment="Center" Template="{StaticResource TemplateButton_BorderStyle}">
                            <StackPanel>
                                <Image Source="Images/Apply32.png" Stretch="None"/>
                                <TextBlock Text="선 택" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Label Name="lbTitleModelList" DockPanel.Dock="left" Content="레시피 리스트" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" />
                    </DockPanel>

                    <ListBox Name="listbox" DockPanel.Dock="Bottom" Padding="10" Foreground="Black" FontSize="20" Background="Transparent">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="5"/>
                                <EventSetter Event="MouseDoubleClick" Handler="listboxItem_MouseDoubleClick"/>
                            </Style>
                            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                                <Setter Property="MinWidth" Value="40" />
                                <Setter Property="MinHeight" Value="40" />
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource StyleBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Label Name="lbTitleSelectedModel" Grid.Row="0" Grid.Column="0" Content="선택된 레시피" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" />
                        <TextBlock Name="tbSelectedModel" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24" />

                        <Label Name="lbLineNo" Grid.Row="1" Grid.Column="0" Content="열 수" FontSize="18" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Name="tbxLineNo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,5" Tag="열 수" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>

                        <Label Name="lbPunchPos" Grid.Row="2" Grid.Column="0" Content="펀치 위치 X, Y (mm)" FontSize="18" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Name="tbxPunchPosX" Grid.Row="2" Grid.Column="1" Margin="10,5" Tag="펀치 위치 X (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <TextBox Name="tbxPunchPosY" Grid.Row="2" Grid.Column="2" Margin="10,5" Tag="펀치 위치 Y (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>

                        <Label Name="lbPunchCenterPos" Grid.Row="3" Grid.Column="0" Content="Center 펀치 위치 X, Y (mm)" FontSize="18" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Name="tbxPunchCenterPosX" Grid.Row="3" Grid.Column="1" Margin="10,5" Tag="Center 펀치 위치 X (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <TextBox Name="tbxPunchCenterPosY" Grid.Row="3" Grid.Column="2" Margin="10,5" Tag="Center 펀치 위치 Y (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>

                        <Label Name="lbBufferPos" Grid.Row="4" Grid.Column="0" Content="버퍼 위치 Z (mm)" FontSize="18" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Name="tbxBufferPosZ" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,5" Tag="버퍼 위치 Z (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>

                        <Label Name="lbPFHole" Grid.Row="5" Grid.Column="0" Content="PF 홀 갯수" FontSize="18" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Name="tbxPFHole" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,5" Tag="PF 홀 갯수" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>

                        <Label Name="lbNGContinue" Grid.Row="6" Grid.Column="0" Content="연속불량 갯수" FontSize="18" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Name="tbxNGContinue" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,5" Tag="연속불량 갯수" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource StyleBorder}">
                <DockPanel LastChildFill="False">
                    <Button Name="btnDelete" Tag="Delete" DockPanel.Dock="Left" Click="btnDelete_Click" Margin="5" Padding="5" Width="110" VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <Image Source="Images/Delete32.png" Stretch="None"/>
                            <TextBlock Text="삭 제" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
