<Page x:Class="SmartICAVI.TeachPunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ut="clr-namespace:SmartICAVI.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="900"
      Background="Cornsilk"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
	Title="TeachPunchPage">

    <Page.Resources>
        <Style TargetType="{x:Type Label}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <ut:DoubleToIntConverter x:Key="convDoubleToInt"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Name="title" Grid.Row="0" Content="PUNCH 티칭" Background="Olive" FontSize="22" FontFamily="Arial" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="0.35*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource StyleBorder}">
                <Grid Name="grabView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <DockPanel LastChildFill="False" Grid.Row="0" Grid.Column="0" >
                        <Button Name="btnImageOpen" Tag="Image Open" DockPanel.Dock="Left" Click="btnImageOpen_Click" Margin="5" Padding="2" Width="110"  VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="Images/Open32.png" Stretch="None"/>
                                <TextBlock Text="열 기" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Name="btnImageSave" Tag="Image Save" DockPanel.Dock="Left" Click="btnImageSave_Click" Margin="5" Padding="2" Width="110"  VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="Images/Save32.png" Stretch="None"/>
                                <TextBlock Text="저 장" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Visibility="Collapsed" Name="btnImageZoomIn" Tag="Image Zoom In" DockPanel.Dock="Left" Click="btnImageZoomIn_Click_1" Margin="5" Padding="2" Width="110"  VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="Images/ZoomIn32.png" Stretch="None"/>
                                <TextBlock Text="확 대" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Visibility="Collapsed" Name="btnImageZoomOut" Tag="Image Zoom Out" DockPanel.Dock="Left" Click="btnImageZoomOut_Click" Margin="5" Padding="2" Width="110"  VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="Images/ZoomOut32.png" Stretch="None"/>
                                <TextBlock Text="축 소" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="btnImageGrab" Tag="Image Grab" DockPanel.Dock="Right" Click="btnImageGrab_Click" Margin="5" Padding="2" Width="110"  VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="Images/Grab32.png" Stretch="None"/>
                                <TextBlock Text="그 랩" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <CheckBox Name="btnImageLive" Tag="Image Live" DockPanel.Dock="Right" Click="btnImageLive_Click" Margin="5" Padding="2"  Width="110" VerticalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Image Source="Images/Live32.png" Stretch="None"/>
                                <TextBlock Text="라이브" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                    </DockPanel>


                    <Canvas Name="canvas" Grid.Row="1" Grid.Column="0" Background="Black">
                        <!--<Image Name="imageAlign" Stretch="Fill" Canvas.Left="0" Canvas.Top="0" Width="{Binding ElementName=canvas, Path=ActualWidth}" Height="{Binding ElementName=canvas, Path=ActualHeight}"/>-->
                    </Canvas>
                    
                    <UniformGrid Visibility="Hidden" Grid.Row="0" Grid.Column="1" Columns="2" Margin="10,5,0,5">
                        <CheckBox Name="cbxLineA" Click="cbxLineA_Click" Margin="5" Padding="2" VerticalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="A 열" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Name="cbxLineB" Click="cbxLineB_Click" Margin="5" Padding="2" VerticalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="B 열" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                    </UniformGrid>

                    <Grid Grid.Row="1" Grid.Column="1" Margin="10,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <CheckBox Name="btnImageSelect" Grid.Row="0" Tag="Image Select" Click="btnImageSelect_Click" Margin="5" VerticalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/ImageSelect32.png" Margin="20,0" Stretch="None"/>
                                <TextBlock Text="선 택" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Visibility="Hidden" Name="btnImageDelete" Grid.Row="1" Tag="Image Delete" Click="btnImageDelete_Click" Margin="5" VerticalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/ImageDelete32.png" Margin="20,0" Stretch="None"/>
                                <TextBlock Text="삭 제" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Name="btnImageInspectArea" Grid.Row="1" Tag="Image Inspect Area" Click="btnImageInspectArea_Click" Margin="5" VerticalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/ImageArea32.png" Margin="20,0" Stretch="None"/>
                                <TextBlock Text="IP 홀 영역" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <Button Name="btnTest" Grid.Row="2" Margin="5" Click="btnTest_Click" VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/Apply32.png" Margin="20,0" Stretch="None"/>
                                <TextBlock Text="검사 테스트" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <CheckBox Visibility="Hidden" Name="btnImageTeach" Grid.Row="2" Tag="Image Teach Area" Click="btnImageTeach_Click" Margin="5" VerticalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/ImageTeach32.png" Margin="20,0" Stretch="None"/>
                                <TextBlock Text="티칭영역" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Visibility="Hidden" Name="btnImageDontCare" Grid.Row="3" Tag="Image Don't Care Area" Click="btnImageDontCare_Click" Margin="5" VerticalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/ImageDontCare32.png" Margin="20,0" Stretch="None"/>
                                <TextBlock Text="Don't Care" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <Label Content="그레이 영역" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="16"/>
                        <Grid Grid.Row="4" Grid.RowSpan="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition Height="0.5*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="min" Margin="0" Grid.Column="0"/>
                                <ScrollBar Name="scbMin" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" ValueChanged="scbMin_ValueChanged" Orientation="Horizontal" HorizontalAlignment="Stretch"/>
                                <Label Grid.Column="2" Margin="0" Content="{Binding ElementName=scbMin, Path=Value, Converter={StaticResource convDoubleToInt}}"/>

                                <Label Content="max" Margin="0" Grid.Row="1" Grid.Column="0"/>
                                <ScrollBar Name="scbMax" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" ValueChanged="scbMax_ValueChanged" Orientation="Horizontal" HorizontalAlignment="Stretch"/>
                                <Label Grid.Row="1" Grid.Column="2" Margin="0" Content="{Binding ElementName=scbMax, Path=Value, Converter={StaticResource convDoubleToInt}}"/>


                            </Grid>
                        </Grid>


                        <Label Content="조명 설정" Grid.Row="6" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>

                        <UniformGrid Grid.Row="7" Columns="2">
                            <TextBox Name="tbxLight" Grid.Row="1" Grid.Column="0" Margin="5" TextAlignment="Left" Text="0" Tag="조명 설정" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                            <Button Name="btnLight" Tag="btnLight" Grid.Row="1" Grid.Column="1" Margin="5" Click="btnLight_Click" VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <!--<Image Source="Images/Grab32.png" Stretch="None"/>-->
                                    <TextBlock Text="적 용" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>
            
            <UniformGrid Grid.Row="1" Grid.Column="0" Columns="2">
                <Border Grid.Row="0" Style="{StaticResource StyleBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Name="cbxAlignXN" Grid.Row="0" Grid.Column="0" Margin="5" Padding="1" Click="cbxAlignXN_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/Back32.png" Margin="2,0" Stretch="None"/>
                                <TextBlock Text="AlignX-" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBox Name="tbxAlignX" Grid.Row="0" Grid.Column="1" Text="0.000" Margin="5" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <CheckBox Name="cbxAlignXP" Grid.Row="0" Grid.Column="2" Margin="5" Padding="1" Click="cbxAlignXP_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/Forward32.png" Margin="2,0" Stretch="None"/>
                                <TextBlock Text="AlignX+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Name="cbxAlignYN" Grid.Row="1" Grid.Column="0" Margin="5" Padding="1" Click="cbxAlignYN_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/UpBlue32.png" Margin="2,0" Stretch="None"/>
                                <TextBlock Text="AlignY-" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBox Name="tbxAlignY" Grid.Row="1" Grid.Column="1" Text="0.000" Margin="5" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <CheckBox Name="cbxAlignYP" Grid.Row="1" Grid.Column="2" Margin="5" Padding="1" Click="cbxAlignYP_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/DownGreen32.png" Margin="2,0" Stretch="None"/>
                                <TextBlock Text="AlignY+" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        
                        <Label Visibility="Hidden" Grid.Row="2" Grid.Column="0" Content="보정값 X" VerticalAlignment="Bottom"/>
                        <Label Visibility="Hidden" Grid.Row="2" Grid.Column="1" Content="보정값 Y" VerticalAlignment="Bottom"/>
                        <CheckBox Name="cbxAlignVision" Grid.Row="2" Grid.Column="2" Margin="5" Padding="1" Click="cbxAlignVision_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <!--<Image Source="Images/DownGreen32.png" Margin="2,0" Stretch="None"/>-->
                                <TextBlock Text="비전확인" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <TextBox Name="tbxAlignPosOffsetX" Grid.Row="2" Grid.Column="1" Text="0.000" Margin="5" TextAlignment="Center" Tag="얼라인위치보정X값 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="Pos X 옵셋" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                        <!--<CheckBox Name="cbxAlignPosOffsetX" Grid.Row="2" Grid.Column="0" Margin="5" Padding="1" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="OffSet X" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        -->
                        <TextBox Name="tbxAlignPosOffsetY" Grid.Row="3" Grid.Column="1" Text="0.000" Margin="5" TextAlignment="Center" Tag="얼라인위치보정Y값 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <Label Grid.Row="3" Grid.Column="0" Content="Pos Y 옵셋" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                        <!--<CheckBox Name="cbxAlignPosOffsetY" Grid.Row="3" Grid.Column="0" Margin="5" Padding="1" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="OffSet Y" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
						-->
                        <CheckBox Name="cbxAlignVisionPosOffset" Grid.Row="3" Grid.Column="3" Margin="5" Padding="1" Click="cbxAlignVisionPosOffset_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <!--<Image Source="Images/DownGreen32.png" Margin="2,0" Stretch="None"/>-->
                                <TextBlock Text="Offset적용" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
						
                        <TextBox Visibility="Hidden" Name="tbxAlignOffsetX" Grid.Row="3" Grid.Column="0" Text="0.000" Margin="5" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <TextBox Visibility="Hidden" Name="tbxAlignOffsetY" Grid.Row="3" Grid.Column="1" Text="0.000" Margin="5" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <Button Visibility="Hidden" Name="btnApplyAlignOffset" Grid.Row="3" Grid.Column="3" Click="btnApplyAlignOffset_Click" Margin="5" Padding="2" Width="110"  VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/Apply32.png" Stretch="None"/>
                                <TextBlock Text="위치적용" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </Grid>
                </Border>
                <Border Grid.Row="0" Style="{StaticResource StyleBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="펀치위치X"/>
                        <TextBox Name="tbxPunchX" Grid.Row="0" Grid.Column="1" Text="0.000" Margin="5" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <UniformGrid Visibility="Hidden" Grid.Row="0" Grid.Column="2" Columns="2">
                            <Label Content="IPHole"/>
                            <TextBox Name="tbxPunchIPHole" Text="0" TextAlignment="Center" Margin="0,5,5,5" Tag="Punch IP Hole 위치" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        </UniformGrid>
                        <Label Grid.Row="1" Grid.Column="0" Content="펀치위치Y"/>
                        <TextBox Name="tbxPunchY" Grid.Row="1" Grid.Column="1" Text="0.000" Margin="5" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <CheckBox Name="cbxPunchTest" Grid.Row="3" Grid.Column="2" Margin="5" Padding="1" Click="cbxPunchTest_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <!--<Image Source="Images/DownGreen32.png" Margin="2,0" Stretch="None"/>-->
                                <TextBlock Text="펀치테스트" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <Label Visibility="Hidden" Grid.Row="2" Grid.Column="0" Content="보정값 X" VerticalAlignment="Bottom"/>
                        <Label Visibility="Hidden" Grid.Row="2" Grid.Column="1" Content="보정값 Y" VerticalAlignment="Bottom"/>
                        
                        <CheckBox Name="cbxPunchVision" Grid.Row="1" Grid.Column="2" Margin="5" Padding="1" Click="cbxPunchVision_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <!--<Image Source="Images/DownGreen32.png" Margin="2,0" Stretch="None"/>-->
                                <TextBlock Text="비전확인" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <TextBox Visibility="Hidden" Name="tbxPunchOffsetX" Grid.Row="3" Grid.Column="0" Text="0.000" Margin="5" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <TextBox Visibility="Hidden" Name="tbxPunchOffsetY" Grid.Row="3" Grid.Column="1" Text="0.000" Margin="5" TextAlignment="Center" Tag="상대 이동거리 (mm)" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                        <Button Visibility="Hidden" Name="btnApplyPunchOffset" Grid.Row="3" Grid.Column="3" Click="btnApplyPunchOffset_Click" Margin="5" Padding="2" Width="110"  VerticalAlignment="Stretch" Template="{StaticResource TemplateButton_BorderStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Image Source="Images/Apply32.png" Stretch="None"/>
                                <TextBlock Text="위치적용" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Label Grid.Row="2" Grid.Column="0" Content="IP Hole" VerticalAlignment="Bottom"/>
                        <Label Grid.Row="3" Grid.Column="0" Content="Line" VerticalAlignment="Bottom"/>
                        <ComboBox Name="cbIPHole" Grid.Row="2" Grid.Column="1" Margin="3" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <ComboBox Name="cbLine" Grid.Row="3" Grid.Column="1" Margin="3" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                    
                </Border>
            </UniformGrid>

            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <CheckBox Name="cbxBufferReady" Visibility="Hidden" Grid.Row="0" Margin="10" Padding="1" Click="cbxBufferReady_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <!--<Image Source="Images/Forward32.png" Margin="10,0" Stretch="None"/>-->
                        <TextBlock Text="버퍼위치 이동" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox Name="cbxReelMoveToPunch" Grid.Row="0" Margin="10" Padding="1" Click="cbxReelMoveToPunch_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <!--<Image Source="Images/Forward32.png" Margin="10,0" Stretch="None"/>-->
                        <TextBlock Text="소재 이동" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox Name="cbxReviewMoveToPunch" Grid.Row="1" Margin="10" Padding="1" Click="cbxReviewMoveToPunch_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <!--<Image Source="Images/Forward32.png" Margin="10,0" Stretch="None"/>-->
                        <TextBlock Text="카메라 이동" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <CheckBox Name="cbxMoveToOrigin" Grid.Row="2" Margin="10" Padding="1" Click="cbxMoveToOrigin_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <!--<Image Source="Images/Forward32.png" Margin="10,0" Stretch="None"/>-->
                        <TextBlock Text="소재 원점이동" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>
                
                <UniformGrid Visibility="Hidden" Grid.Row="4" Columns="2">
                    <Label Content="테스트 갯수"/>
                    <TextBox Name="tbxPunchTestNo" Text="5" TextAlignment="Center" Margin="5, 15" Tag="Punch IP Hole 위치" Style="{StaticResource StyleTextBox}" PreviewMouseUp="tbxNumber_PreviewMouseUp" SelectionChanged="tbx_SelectionChanged"/>
                </UniformGrid>

                <CheckBox Visibility="Hidden" Name="cbxPunchTestInspect" Grid.Row="5" Margin="10" Padding="1" Click="cbxPunchTestInspect_Click" Template="{StaticResource TemplateCheckBox_SelectStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <!--<Image Source="Images/Forward32.png" Margin="10,0" Stretch="None"/>-->
                        <TextBlock Text="펀치위치 테스트" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <ListBox Visibility="Hidden" Name="listbox" Grid.Row="6" Grid.RowSpan="3" Padding="5" Margin="5" Foreground="Black" FontSize="17" Background="Transparent">
                    <ListBox.Resources>
                        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                            <Setter Property="MinWidth" Value="20" />
                            <Setter Property="MinHeight" Value="20" />
                        </Style>
                    </ListBox.Resources>
                </ListBox>

                <ut:StopButton x:Name="btnStop" Grid.Row="9" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Click="btnStop_Click" Margin="5" Padding="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Template="{StaticResource TemplateCheckBox_StopStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Margin="10"  Source="Images/Stop48.png" Stretch="None"/>
                        <TextBlock Text="정 지" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </ut:StopButton>

            </Grid>
        </Grid>
    </Grid>
</Page>
