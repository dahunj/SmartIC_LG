                    <CheckBox Name="cbxDio" Tag="cbxDio" Click="cbx_Click" Template="{StaticResource TemplateCheckBox_JogStyle}">
                        <TextBlock Text="입출력" Foreground="White" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </CheckBox>
                    
                    <CheckBox Name="cbxUncoiler" Tag="cbxUncoiler" Click="cbx_Click" Template="{StaticResource TemplateCheckBox_JogStyle}">
                        <TextBlock Text="공급 릴" Foreground="White" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </CheckBox>

                    <CheckBox Name="cbxRecoiler" Tag="cbxRecoiler" Click="cbx_Click" Template="{StaticResource TemplateCheckBox_JogStyle}">
                        <TextBlock Text="수급 릴" Foreground="White" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </CheckBox>

                    <CheckBox Name="cbxVisionFeed" Tag="cbxVisionFeed" Click="cbx_Click" Template="{StaticResource TemplateCheckBox_JogStyle}">
                        <TextBlock Text="비젼 Feed" Foreground="White" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </CheckBox>

                    <CheckBox Name="cbxVisionTop" Tag="cbxVisionTop" Click="cbx_Click" Template="{StaticResource TemplateCheckBox_JogStyle}">
                        <TextBlock Text="비젼 Top" Foreground="White" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
