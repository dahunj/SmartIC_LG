                    <RadioButton GroupName="gpView" Name="rdViewVerify" Tag="0" Margin="20,0" Content="  Verify View" VerticalAlignment="Center" FontFamily="Arial" Style="{StaticResource StyleRadioButton}" Click="rdViewVerify_Click"/>
                    <RadioButton GroupName="gpView" Name="rdViewPunch" Tag="1" Margin="20,0" Content="  Punch View" VerticalAlignment="Center" FontFamily="Arial" Style="{StaticResource StyleRadioButton}" Click="rdViewPunch_Click"/>
                    <RadioButton GroupName="gpView" Name="rdViewSelect" Tag="2" Margin="20,0" Content="  Select View" VerticalAlignment="Center" FontFamily="Arial" Style="{StaticResource StyleRadioButton}" Click="rdViewSelect_Click"/>
                </UniformGrid>

                <ListView Name="listViewNG" Grid.Row="1" Padding="2" Margin="2" BorderBrush="Black" Foreground="Black" FontSize="12" Background="Transparent" SelectionChanged="lbxViewNG_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="No." DisplayMemberBinding="{Binding Path=NgNo}" Width="40"/>
                            <GridViewColumn Header="Index" DisplayMemberBinding="{Binding Path=NgIndex}" Width="55"/>
                            <GridViewColumn Header="Line" DisplayMemberBinding="{Binding Path=NgLine}" Width="30"/>
                            <GridViewColumn Header="Defect" DisplayMemberBinding="{Binding Path=NgName}" Width="90"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Label x:Name="lblJudgeResult" Grid.Row="1" Grid.RowSpan="3" Content="GOOD" Visibility="Collapsed" FontSize="400" FontWeight="Bold" FontFamily="Headline R" Foreground="Blue" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
    </Grid>
</Window>
