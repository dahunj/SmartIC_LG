<Window x:Class="SmartICAVI.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource StyleCustomWindow}"
        Name="messageWindow"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Closed="messageWindow_Closed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="MessageWindow" MinHeight="550" MinWidth="800" xmlns:my="clr-namespace:SmartICAVI.UserControls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Name="tblMessageNum" Grid.Row="0" Padding="5" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                <Canvas Name="canvas" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image Name="image" Source="Images/Stop48.png" Stretch="Fill" Canvas.Left="0" Canvas.Top="0" Width="{Binding ElementName=canvas, Path=ActualWidth}" Height="{Binding ElementName=canvas, Path=ActualHeight}"/>
                </Canvas>
            </Grid>
            
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="2.5*"/>
                </Grid.RowDefinitions>
                <TextBlock Name="tblMessage" Grid.Row="0" Padding="5" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Name="tblDescription" Grid.Row="1" Padding="5" FontSize="24" TextWrapping="Wrap"/>
            </Grid>
        </Grid>
        
        <UniformGrid Grid.Row="1" Columns="2">
            <Button Name="btnOK" Margin="5,0,5,5" Click="btnOK_Click" Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Margin="10,0" Source="Images/Apply32.png" Stretch="None"/>
                    <TextBlock Text="확   인" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Name="btnCancel" Margin="5,0,5,5" Click="btnCancel_Click" Template="{StaticResource TemplateButton_MenuStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Margin="10,0" Source="Images/Cancel32.png" Stretch="None"/>
                    <TextBlock Text="취   소" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</Window>
