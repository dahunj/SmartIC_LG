<Window x:Class="SmartICAVI.TeachRecipeNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ut="clr-namespace:SmartICAVI.UserControls"
        Style="{StaticResource StyleCustomWindow}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Opacity="0.99"
        Loaded="Window_Loaded"
        Unloaded="Window_Unloaded"
        Closed="Window_Closed"
        Title="Recipe Name" Height="350" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition/>
            <RowDefinition  Height="0.5*"/>
            <RowDefinition/>
        
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="1" Columns="2">
            <Label Name="lblName" Margin="5" Content="레시피(모델) 이름 : " FontSize="22" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox Name="tbxRecipeName" Text="" Margin="0,10, 10, 10" FontSize="22" FontFamily="Arial" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource StyleTextBox}"/>
        </UniformGrid>

        <Button Name="btnOK" Grid.Row="4" Margin="5" Click="btnOK_Click" Template="{StaticResource TemplateButton_MenuStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Margin="10,0" Source="Images/Apply32.png" Stretch="None"/>
                <TextBlock Text="확 인" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        
        
    </Grid>
</Window>
