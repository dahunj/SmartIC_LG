                        <TextBlock Text="비젼 Bottom" Foreground="White" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </CheckBox>

                    <CheckBox Name="cbxPunchFeed" Tag="cbxPunchFeed" Click="cbx_Click" Template="{StaticResource TemplateCheckBox_JogStyle}">
                        <TextBlock Text="펀치 Feed" Foreground="White" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
